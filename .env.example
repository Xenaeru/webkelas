# Postgres connection string. Leave empty to use the local PGlite database
# at .data/pglite (zero-config, good for local dev and tests).
#
# Supabase: Project Settings → Database → Connection string → "Connection pooling".
# Use the pooler on port 6543 for serverless (Vercel) deployments.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Set to "require" when your provider needs TLS (Supabase does).
# DATABASE_SSL=require

# Max clients in the pool. Keep 1-3 on serverless to protect Supabase limits.
# DATABASE_POOL_MAX=3
